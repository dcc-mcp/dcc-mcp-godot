{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcc-mcp.dev/schemas/godot/playtest-actions-manifest-v1.schema.json",
  "title": "DCC-MCP Godot playtest action manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "project_id",
    "session_id",
    "authority",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "$ref": "#/$defs/identity"
    },
    "project_id": {
      "$ref": "#/$defs/identity"
    },
    "session_id": {
      "$ref": "#/$defs/identity"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "max_actions", "rate_limit"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_actions", "window_msec"],
          "properties": {
            "max_actions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "window_msec": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "thread", "target", "arguments", "readback"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identity"
              },
              "kind": {
                "const": "input_action"
              },
              "thread": {
                "enum": ["main", "physics"]
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action"],
                "properties": {
                  "action": {
                    "$ref": "#/$defs/identity"
                  }
                }
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pressed", "strength"],
                "properties": {
                  "pressed": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "boolean"
                    }
                  },
                  "strength": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["minimum", "maximum"],
                    "properties": {
                      "minimum": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0
                      },
                      "maximum": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0
                      }
                    }
                  }
                }
              },
              "readback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "input_action"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "thread", "target", "arguments", "readback"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identity"
              },
              "kind": {
                "const": "set_property"
              },
              "thread": {
                "enum": ["main", "physics"]
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_path",
                  "node_type",
                  "script_path",
                  "script_sha256",
                  "property"
                ],
                "properties": {
                  "node_path": {
                    "type": "string",
                    "pattern": "^/root/[A-Za-z0-9_./:-]+$",
                    "maxLength": 500
                  },
                  "node_type": {
                    "$ref": "#/$defs/identity"
                  },
                  "script_path": {
                    "type": "string",
                    "pattern": "^res://[A-Za-z0-9_./-]+[.]gd$",
                    "maxLength": 500
                  },
                  "script_sha256": {
                    "$ref": "#/$defs/digest"
                  },
                  "property": {
                    "$ref": "#/$defs/identity"
                  }
                }
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": {
                  "value": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "const": "boolean"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "minimum", "maximum"],
                        "properties": {
                          "type": {
                            "enum": ["integer", "number"]
                          },
                          "minimum": {
                            "type": "number",
                            "minimum": -1000000,
                            "maximum": 1000000
                          },
                          "maximum": {
                            "type": "number",
                            "minimum": -1000000,
                            "maximum": 1000000
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "enum"],
                        "properties": {
                          "type": {
                            "const": "string"
                          },
                          "enum": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 32,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "maxLength": 128
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "readback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "node_path", "property"],
                "properties": {
                  "kind": {
                    "const": "property"
                  },
                  "node_path": {
                    "type": "string",
                    "pattern": "^/root/[A-Za-z0-9_./:-]+$",
                    "maxLength": 500
                  },
                  "property": {
                    "$ref": "#/$defs/identity"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
